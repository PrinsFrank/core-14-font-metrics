{
    "name": "prinsfrank/core-14-font-metrics",
    "description": "Font metrics for the core 14 PostScript Fonts",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PrinsFrank\\Core14FontMetrics\\": "src/"
        }
    },
    "require": {},
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --allow-risky=yes --dry-run",
        "cs:fix": "php-cs-fixer fix --allow-risky=yes",
        "stan": "phpstan analyse --memory-limit 4G -v",
        "stan-fix": "phpstan analyse --memory-limit 4G -v --fix"
    }
}
